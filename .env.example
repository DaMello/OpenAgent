# OpenAgent home. On Windows OpenAgent automatically prefers E:\Agent when it exists.
OPENAGENT_HOME=E:\Agent

# Ollama / Qwen
OPENAGENT_OLLAMA_URL=http://127.0.0.1:11434

# Leave blank to auto-detect the first installed Ollama model containing "qwen".
OPENAGENT_MODEL=

# Context accounting target. The UI will eventually surface this as a meter.
OPENAGENT_CONTEXT_WINDOW=131072
OPENAGENT_AUTO_COMPACT_RATIO=0.75
